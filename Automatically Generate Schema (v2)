function wem_get_canonical_author_name($slug) {
    $authors_names = array(
        'sfehling' => 'Samuel Fehling',
        'mbarrios' => 'Minerva Barrios',
    );

    return $authors_names[$slug] ?? '';
}

function wem_get_schema_image_object($url) {
    if (!$url) return null;
    $image_path = parse_url($url, PHP_URL_PATH);
    $full_path = $_SERVER['DOCUMENT_ROOT'] . $image_path;

    $image_obj = array('@type' => 'ImageObject', 'url' => $url);

    if (file_exists($full_path)) {
        $size = @getimagesize($full_path);
        if ($size) {
            $image_obj['width'] = $size[0];
            $image_obj['height'] = $size[1];
        }
    }

    return $image_obj;
}

function wem_generate_schema_from_blocks($content) {
    $dom = new DOMDocument();
    libxml_use_internal_errors(true);
    $content = mb_convert_encoding($content, 'HTML-ENTITIES', 'UTF-8');
    $dom->loadHTML($content, LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
    libxml_clear_errors();

    $schemas = [];
    $processed_names = [];
    $ratings_raw = get_post_meta(get_the_ID(), 'rating', true);
    $ratings_lines = explode("\n", $ratings_raw);

    foreach ($dom->getElementsByTagName('div') as $group) {
        if (strpos($group->getAttribute('class'), 'wp-block-group') === false) continue;

        $h3s = $group->getElementsByTagName('h3');
        if ($h3s->length === 0) continue;
        
        $name = trim($h3s->item(0)->textContent);
        if (empty($name) || in_array($name, $processed_names)) continue;

        $description = $image_url = '';
        $rating_value = 5;

        foreach ($group->getElementsByTagName('p') as $p) {
            $text = trim($p->textContent);
            if (!empty($text)) {
                $description = $text;
                break;
            }
        }

        foreach ($group->getElementsByTagName('img') as $img) {
            $image_url = $img->getAttribute('src');
            break;
        }

        foreach ($ratings_lines as $line) {
            if ($name && strpos($line, $name) !== false) {
                $parts = explode(' ', trim($line));
                $rating_value = floatval(end($parts));
                break;
            }
        }

        if ($name && $description && $image_url) {
            $processed_names[] = $name;
            $schemas[] = array(
                '@context' => 'https://schema.org',
                '@type' => 'Product',
                'name' => $name,
                'image' => wem_get_schema_image_object($image_url),
                'description' => $description,
                'review' => array(
                    '@type' => 'Review',
                    'author' => array('@id' => 'https://witheachmile.com/#organization'),
                    'reviewRating' => array(
                        '@type' => 'Rating',
                        'ratingValue' => $rating_value,
                        'bestRating' => '5',
                        'worstRating' => '1'
                    )
                )
            );
        }
    }
    return $schemas;
}

function wem_generate_schema() {
    $org_id = 'https://witheachmile.com/#organization';
    $website_id = 'https://witheachmile.com/#website';
    $logo_url = 'https://witheachmile.com/wp-content/uploads/2026/03/With-Each-Mile-Full-Size.webp';

    $sfehling_user = get_user_by('slug', 'sfehling');
    $mbarrios_user = get_user_by('slug', 'mbarrios');

    $org_schema = array(
        '@context' => 'https://schema.org',
        '@type' => 'Organization',
        '@id' => $org_id,
        'name' => 'With Each Mile',
        'url' => 'https://witheachmile.com/',
        'description' => 'National Park guides and dog-friendly road trip tips that fit into real life.',
        'foundingDate' => '2024-02-01',
        'founder' => array(
            array(
                '@type' => 'Person',
                '@id' => ($sfehling_user ? get_author_posts_url($sfehling_user->ID) : '') . '#person',
                'name' => wem_get_canonical_author_name('sfehling'),
                'alternateName' => $sfehling_user ? get_the_author_meta('display_name', $sfehling_user->ID) : '',
                'sameAs' => wem_get_social_profiles('sfehling')
            ),
            array(
                '@type' => 'Person',
                '@id' => ($mbarrios_user ? get_author_posts_url($mbarrios_user->ID) : '') . '#person',
                'name' => wem_get_canonical_author_name('mbarrios'),
                'alternateName' => $mbarrios_user ? get_the_author_meta('display_name', $mbarrios_user->ID) : '',
                'sameAs' => wem_get_social_profiles('mbarrios')
            )
        ),
        'logo' => wem_get_schema_image_object($logo_url),
        'sameAs' => wem_get_social_profiles('default')
    );
    echo '<script type="application/ld+json">' . wp_json_encode($org_schema, JSON_UNESCAPED_SLASHES) . '</script>';

    if (is_front_page() || is_home()) {
        $web_schema = array(
            '@context' => 'https://schema.org',
            '@type' => 'WebSite',
            '@id' => $website_id,
            'name' => 'With Each Mile',
            'url' => 'https://witheachmile.com/',
            'description' => 'National Park guides, dog-friendly road trips, and hiking itineraries from real trips.',
            'inLanguage' => 'en-US',
            'publisher' => array('@id' => $org_id),
            'about' => array('@id' => $org_id),
            'potentialAction' => array(
                '@type' => 'SearchAction',
                'target' => array(
                    '@type' => 'EntryPoint',
                    'urlTemplate' => 'https://witheachmile.com/?s={search_term_string}'
                ),
                'query-input' => 'required name=search_term_string'
            )
        );
        echo '<script type="application/ld+json">' . wp_json_encode($web_schema, JSON_UNESCAPED_SLASHES) . '</script>';
    }

    if (is_author()) {
        $author_id = get_queried_object_id();
        $author_slug = get_the_author_meta('user_nicename', $author_id);
        $author_url = get_author_posts_url($author_id);
        $canonical_name = wem_get_canonical_author_name($author_slug);
        $display_name = get_the_author_meta('display_name', $author_id);

        $author_page_schema = array(
            '@context' => 'https://schema.org',
            '@type' => 'ProfilePage',
            'mainEntity' => array(
                '@type' => 'Person',
                '@id' => $author_url . '#person',
                'name' => !empty($canonical_name) ? $canonical_name : $display_name,
                'alternateName' => $display_name,
                'url' => $author_url,
                'image' => get_avatar_url($author_id, ['size' => 500]),
                'description' => get_the_author_meta('description', $author_id),
                'sameAs' => wem_get_social_profiles($author_slug),
                'worksFor' => array('@id' => $org_id)
            )
        );
        
        echo '<script type="application/ld+json">' . wp_json_encode($author_page_schema, JSON_UNESCAPED_SLASHES) . '</script>';
    }

    if (is_single() && !is_page('our-gear')) {
        global $post;
        $author_id = $post->post_author;
        $author_slug = get_the_author_meta('user_nicename', $author_id);
        $author_url = get_author_posts_url($author_id);
        $post_url = get_permalink();
        $canonical_name = wem_get_canonical_author_name($author_slug);
        $display_name = get_the_author_meta('display_name', $author_id);

        $blog_schema = array(
            '@context' => 'https://schema.org',
            '@type' => 'BlogPosting',
            'headline' => get_the_title(),
            'url' => $post_url,
            'inLanguage' => 'en-US',
            'datePublished' => get_the_date('c'),
            'dateModified' => get_the_modified_date('c'),
            'author' => array(
                '@type' => 'Person',
                '@id' => $author_url . '#person',
                'name' => !empty($canonical_name) ? $canonical_name : $display_name,
                'alternateName' => $display_name,
                'url' => $author_url,
                'sameAs' => wem_get_social_profiles($author_slug),
                'description' => get_the_author_meta('description', $author_id)
            ),
            'publisher' => array('@id' => $org_id),
            'isPartOf' => array('@id' => $website_id),
            'mainEntityOfPage' => array('@type' => 'WebPage', '@id' => $post_url, 'url' => $post_url),
            'potentialAction' => array(
                '@type' => 'ReadAction', 
                'target' => array(
                    '@type' => 'EntryPoint', 
                    'url' => $post_url
                )
            )
        );

        preg_match_all('/<script[^>]*type=[\'"]application\/ld\+json[\'"][^>]*>(.*?)<\/script>/is', $post->post_content, $scripts);
        if (!empty($scripts[1])) {
            foreach ($scripts[1] as $json) {
                $data = json_decode($json, true);
                if ($data && isset($data['@type'], $data['@id']) && in_array($data['@type'], ['TouristAttraction', 'Place'])) {
                    $blog_schema['about'] = array('@id' => $data['@id']);
                    break;
                }
            }
        }

        preg_match_all('/<h[2-3][^>]*>(.*?)<\/h[2-3]>/i', $post->post_content, $matches);
        if (!empty($matches[1])) {
            $blog_schema['articleSection'] = array_map('wp_strip_all_tags', $matches[1]);
        }

        $all_images = [];
        $feat = get_the_post_thumbnail_url($post->ID, 'full');
        if ($feat) $all_images[] = $feat;

        preg_match_all('/<img[^>]+src=[\'"]([^\'"]+)[\'"][^>]*>/i', $post->post_content, $img_matches);
        if (!empty($img_matches[1])) {
            foreach (array_unique($img_matches[1]) as $img_url) {
                if ($img_url !== $feat) $all_images[] = $img_url;
            }
        }

        $image_objects = [];
        foreach ($all_images as $img_url) {
            $obj = wem_get_schema_image_object($img_url);
            if ($obj) $image_objects[] = $obj;
        }

        if ($image_objects) $blog_schema['image'] = $image_objects;

        echo '<script type="application/ld+json">' . wp_json_encode($blog_schema, JSON_UNESCAPED_SLASHES) . '</script>';
    }

    if (is_page('about-us')) {
        $about_schema = array(
            '@context' => 'https://schema.org',
            '@type' => 'AboutPage',
            'name' => 'About Us - With Each Mile',
            'url' => get_permalink(),
            'datePublished' => get_the_date('c'),
            'dateModified' => get_the_modified_date('c'),
            'description' => 'Join Minerva Barrios & Samuel Fehling as they travel the U.S. with their dogs...',
            'publisher' => array('@id' => $org_id),
            'creator' => array(
                array(
                    '@type' => 'Person', 
                    'name' => wem_get_canonical_author_name('sfehling'), 
                    'alternateName' => $sfehling_user ? get_the_author_meta('display_name', $sfehling_user->ID) : '',
                    '@id' => ($sfehling_user ? get_author_posts_url($sfehling_user->ID) : '') . '#person', 
                    'sameAs' => wem_get_social_profiles('sfehling')
                ),
                array(
                    '@type' => 'Person', 
                    'name' => wem_get_canonical_author_name('mbarrios'), 
                    'alternateName' => $mbarrios_user ? get_the_author_meta('display_name', $mbarrios_user->ID) : '',
                    '@id' => ($mbarrios_user ? get_author_posts_url($mbarrios_user->ID) : '') . '#person', 
                    'sameAs' => wem_get_social_profiles('mbarrios')
                )
            )
        );
        echo '<script type="application/ld+json">' . wp_json_encode($about_schema, JSON_UNESCAPED_SLASHES) . '</script>';
    }

    if (is_page('our-gear')) {
        global $post;
        $gear_page_schema = array(
            '@context' => 'https://schema.org',
            '@type' => 'WebPage',
            'name' => 'Our Gear - With Each Mile',
            'description' => 'Explore the gear we use and recommend.',
            'publisher' => array('@id' => $org_id),
            'datePublished' => get_the_date('c'),
            'dateModified' => get_the_modified_date('c')
        );
        echo '<script type="application/ld+json">' . wp_json_encode($gear_page_schema, JSON_UNESCAPED_SLASHES) . '</script>';

        foreach (wem_generate_schema_from_blocks($post->post_content) as $product) {
            echo '<script type="application/ld+json">' . wp_json_encode($product, JSON_UNESCAPED_SLASHES) . '</script>';
        }
    }
}
add_action('wp_head', 'wem_generate_schema');
